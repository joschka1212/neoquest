# NeoQuest Server Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# Database Configuration (Connection to neoquest_db)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=neoquest
DB_USER=neoquest_app
DB_PASSWORD=CHANGE_ME
DB_SCHEMA=neoquest

# Security
JWT_SECRET=CHANGE_ME_long_random_string
JWT_EXPIRES_IN=24h

# File Upload Configuration  
UPLOAD_MAX_SIZE=50MB
UPLOAD_DIR=./uploads
MEDIA_DIR=./media
TEMP_DIR=./temp

# Network Security (LAN only)
ALLOWED_IP_RANGES=192.168.1.0/24,10.0.0.0/24,172.16.0.0/12
ENABLE_CORS=true

# ESP32 Configuration
ESP32_UDP_PORT=8888
ESP32_BROADCAST_IP=192.168.1.255
ESP32_TIMEOUT=5000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/neoquest-server.log
ENABLE_REQUEST_LOGGING=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Game Configuration
GPS_TRACKING_INTERVAL=30
DEFAULT_CHECKPOINT_RADIUS=15
MAX_GAME_DURATION=7200

# Development
DEBUG=neoquest:*
ENABLE_API_DOCS=true
