# NeoQuest Server Environment Configuration
# Kopiere diese Datei zu .env und passe die Werte an

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=neoquest
# Admin-Zugang (Superuser) - fuer Setup und Migrationen
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=CHANGE_ME
# App-Zugang (wird von setup-database.js angelegt)
DB_USER=neoquest_app
DB_PASSWORD=CHANGE_ME
DB_SCHEMA=neoquest

# Server Configuration
PORT=3000
NODE_ENV=development

# Security
JWT_SECRET=CHANGE_ME_long_random_string
UPLOAD_MAX_SIZE=50MB

# File Storage
MEDIA_DIR=./media
UPLOAD_DIR=./uploads

# Network Security
ALLOWED_IP_RANGES=192.168.1.0/24,10.0.0.0/24

# ESP32 Configuration
ESP32_UDP_PORT=8888
ESP32_BROADCAST_IP=192.168.1.255

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/neoquest.log

# Development
DEBUG=neoquest:*
